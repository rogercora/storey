# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. NEVER expose to the browser. Used by /api/admin/* for storage clean-up and bulk import.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Vision AI (server only) ---
# "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Max photos per analysis request / max size per photo (MB)
AI_MAX_PHOTOS=4
AI_MAX_PHOTO_MB=6

